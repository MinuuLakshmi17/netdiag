<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>netdiag</AssemblyName>
    <RootNamespace>NetDiag</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Cross-platform network diagnostics CLI: DNS, TCP, ICMP, interfaces, NAT and firewall checks.</Description>
  </PropertyGroup>

</Project>
